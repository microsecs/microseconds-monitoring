# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Application base URL
# Local: http://localhost:3000
# Production: https://monitoring.microseconds.com
APP_URL=http://localhost:3000

# Microsoft Entra / Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional override. If omitted, APP_URL + /api/microsoft/callback is used.
MICROSOFT_REDIRECT_URI=

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep this stable after production launch; changing it makes stored Google refresh tokens unreadable.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional override. If omitted, APP_URL + /api/google/callback is used.
GOOGLE_REDIRECT_URI=

# IP intelligence
IPINFO_TOKEN=

# Incident analysis
OPENAI_API_KEY=
OPENAI_INCIDENT_MODEL=

# Email / alerts / support
RESEND_API_KEY=
SECURITY_ALERT_FROM=
SUPPORT_EMAIL_FROM=
SUPPORT_EMAIL_TO=

# Scheduled jobs
CRON_SECRET=

# Current single-organization development defaults
DEV_ORGANIZATION_NAME=
DEV_ORGANIZATION_SLUG=

# Account bootstrap: set this in Vercel to the email address that should own/claim
# the existing MicroSECONDS organization on first authenticated login.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
